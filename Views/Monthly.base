filters:
  and:
    - 'file.inFolder("Entries")'
    - 'file.ext == "md"'
    - 'date(note.created).format("YYYY-MM") == today().format("YYYY-MM") || (note.scheduled && date(note.scheduled).format("YYYY-MM") == today().format("YYYY-MM"))'
views:
  - type: table
    name: Monthly
    order:
      - file.name
      - note.type
      - note.description
      - note.scheduled
      - note.status
      - note.collection
