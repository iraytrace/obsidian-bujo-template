filters:
  and:
    - file.inFolder("Entries")
    - file.ext == "md"
    - or:
        - and:
            - 'note.scheduled.isEmpty()'
            - 'note.type == "task" || note.type == "event"'
        - and:
            - '!note.scheduled.isEmpty()'
            - 'date(note.scheduled).format("YYYY-MM") > today().format("YYYY-MM")'
views:
  - type: table
    name: Future
    order:
      - type
      - description
      - scheduled
      - status
      - collection
