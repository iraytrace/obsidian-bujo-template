filters:
  and:
    - 'file.inFolder("Entries")'
    - 'file.ext == "md"'
    - '!note.collection.isEmpty()'
views:
  - type: table
    name: Collections
    groupBy:
      property: note.collection
      direction: ASC
    order:
      - note.type
      - note.description
      - note.scheduled
      - note.status
      - note.collection
